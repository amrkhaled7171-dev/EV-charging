# Copy this file to .env.local and edit it. Never commit .env.local.

# mysql://USER:PASSWORD@HOST:PORT/DATABASE   (URL-encode special characters: @ -> %40)
DATABASE_URL=mysql://root:YOUR_PASSWORD@localhost:3306/ev_charging_db

# API key required on every POST /api/*  (header: X-API-Key)
API_KEY=change-me
# Same value, used by the dashboard's "maintenance" button (prototype level only)
NEXT_PUBLIC_API_KEY=change-me

# Thresholds (section 9.2 of the design document) - defaults shown
STALE_TIMEOUT_SEC=15
OVER_TEMP_C=70
OVER_CURRENT_A=40
VOLTAGE_MIN_V=200
VOLTAGE_MAX_V=250
IN_USE_CURRENT_A=0.5

# Background jobs
OFFLINE_JOB_INTERVAL_SEC=5
RETENTION_DAYS=7
PURGE_INTERVAL_MIN=60
